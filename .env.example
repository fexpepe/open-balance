# Copie este arquivo para .env (na mesma pasta) e preencha.
# O .env nunca deve ir para o git nem para pastas sincronizadas (Google Drive etc.).

# Development Application: dashboard.pluggy.ai → Applications
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Item IDs copiados na Demo (menu ⋯ → "Copiar Item ID"), separados por vírgula.
# Um por banco vinculado via MeuPluggy.
PLUGGY_ITEM_IDS=
